<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".TipsFragment">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Predict Your Monthly Emissions"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Year: user types it manually -->
        <EditText
            android:id="@+id/edit_year"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:hint="Year (e.g. 2025)"
            android:inputType="number" />

        <!-- Month dropdown -->
        <Spinner
            android:id="@+id/spinner_month"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:entries="@array/months_array" />

        <EditText
            android:id="@+id/edit_electricity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="Electricity (kWh total)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_lpg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="LPG (kg)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_petrol"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="Petrol (liters)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_diesel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="Diesel (liters)"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/button_predict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Predict Emissions" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Prediction Results"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_current_prediction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Predicted Emission for..."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="6-Month Forecast"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layout_future_predictions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Personalized Suggestions"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            tools:text="- Suggestion 1\n- Suggestion 2" />

    </LinearLayout>
</ScrollView>
