        android:pathData="M2,11h4v2H2z"/>
    <path
        android:fillColor="?attr/colorOnSurface"
        android:pathData="M18,11h4v2h-4z"/>

    <!-- Rays (diagonal, by rotating the cardinal rays) -->
    <group android:rotation="45" android:pivotX="12" android:pivotY="12">
        <path
            android:fillColor="?attr/colorOnSurface"
            android:pathData="M11,2h2v4h-2z"/>
        <path
            android:fillColor="?attr/colorOnSurface"
            android:pathData="M11,18h2v4h-2z"/>
        <path
            android:fillColor="?attr/colorOnSurface"
            android:pathData="M2,11h4v2H2z"/>
        <path
            android:fillColor="?attr/colorOnSurface"
            android:pathData="M18,11h4v2h-4z"/>
