    <!-- Central Circle -->
    <path
        android:fillColor="?attr/colorOnSurface"
        android:pathData="M12,12m-3,0a3,3 0,1 0,6 0a3,3 0,1 0,-6 0z"/>

    <!-- Rays (cardinal directions) -->
    <path
        android:fillColor="?attr/colorOnSurface"
        android:pathData="M11,2h2v4h-2z"/>
    <path
        android:fillColor="?attr/colorOnSurface"
        android:pathData="M11,18h2v4h-2z"/>
